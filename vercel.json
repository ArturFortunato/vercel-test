{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/artur/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "XXX"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Server",
          "value": "Artur-hacking"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/locales/:path*",
      "destination": "https://proxy-locales.framersandbox.dev/:path*"
    },
    {
      "source": "/private(.*)",
      "destination": "https://proxy-private.framersandbox.dev"
    },
    {
      "source": "/_framer/login",
      "destination": "https://proxy-private.framersandbox.dev/_framer/login"
    },
    {
      "source": "/old/my-blog/:slug",
      "destination": "https://proxy-blog.framersandbox.dev/blog/:slug"
    },
    {
      "source": "/old/my-blog",
      "destination": "https://proxy-blog.framersandbox.dev/blog"
    },
    {
      "source": "/my-blog/:slug",
      "destination": "https://proxy-blog.framersandbox.dev/my-blog/:slug"
    },
    {
      "source": "/my-blog",
      "destination": "https://proxy-blog.framersandbox.dev/blog/"
    },
    {
      "source": "/old/blog/:slug",
      "destination": "https://proxy-blog.framersandbox.dev/blog/:slug"
    },
    {
      "source": "/old/blog",
      "destination": "https://proxy-blog.framersandbox.dev/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://proxy-blog.framersandbox.dev/blog/:slug"
    },
    {
      "source": "/blog",
      "destination": "https://proxy-blog.framersandbox.dev/blog"
    },
    {
      "source": "/:locale(pt)/new-products/:id",
      "destination": "https://proxy-products.framersandbox.dev/:locale/products/:id"
    },
    {
      "source": "/new-products/:id",
      "destination": "https://proxy-products.framersandbox.dev/products/:id"
    },
    {
      "source": "/motion",
      "destination": "https://www.motion.dev"
    },
    {
      "source": "/path-to-root",
      "destination": "https://proxy-landing.framersandbox.dev/"
    },
    {
      "source": "/fastclip/:path*",
      "destination": "https://www.fastclip.io/:path*"
    },
    {
      "source": "/external/:path*",
      "destination": "https://proxy-landing.framersandbox.dev/:path*"
    },
    {
      "source": "/",
      "destination": "https://proxy-landing.framersandbox.dev/"
    }
  ],
    "redirects": [
    {
      "source": "/motion",
      "destination": "https://google.com",
      "permanent": true
    }
  ]
}
